      "Bash(taskkill:*)",
      "Bash(nul)",
      "Bash(netstat:*)",
      "Bash(findstr:*)",
      "Bash(timeout 5 npm run dev:*)",
      "Bash(cmd /c \"rd /s /q .next 2>nul & del /q *.lock 2>nul & echo Directory cleaned\")",
      "Bash(curl:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(powershell -Command \"Remove-Item -Path nul -Force\")",
      "Bash(git rm:*)"
